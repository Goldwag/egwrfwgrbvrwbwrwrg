+// A touchscreen has no hover: the pointer only exists while the stylus/finger
+// is down and on the frame it lifts (so Left Released still fires). On the next
+// frame it is gone, which lets Mouse Leave fire instead of leaving the
+// instance stuck in its hovered state forever.
+static bool Runner_pointerActive(Runner* runner) {
+    RunnerMouseState* m = runner->mouse;
+    if (m == nullptr || !m->positionValid) return false;
+    if (!m->touchOnly) return true;
+    return m->buttonDown[MB_LEFT] || m->buttonReleased[MB_LEFT];
+}
+
 // Test the current mouse position against an instance's collision mask.
